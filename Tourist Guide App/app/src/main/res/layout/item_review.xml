<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:stateListAnimator="@animator/card_lift"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/premium_card_radius"
    app:cardElevation="4dp"
    app:strokeColor="@color/premium_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <TextView
                    android:id="@+id/tvReviewInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_gradient"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="A" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivReviewUserPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/CircleImage" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReviewUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/color_on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Aarav Sharma" />

                <TextView
                    android:id="@+id/tvReviewDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/color_text_muted"
                    android:textSize="12sp"
                    tools:text="Jan 24, 2026" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnEditReview"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/update_review"
                android:padding="8dp"
                android:src="@drawable/ic_ms_edit"
                android:visibility="gone"
                app:tint="@color/color_primary" />

            <ImageButton
                android:id="@+id/btnDeleteReview"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete review"
                android:padding="8dp"
                android:src="@drawable/ic_ms_delete"
                android:visibility="gone"
                app:tint="@color/color_error" />

            <ImageButton
                android:id="@+id/btnReportReview"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Report review"
                android:padding="8dp"
                android:src="@drawable/ic_ms_flag"
                app:tint="@color/color_text_muted" />
        </LinearLayout>

        <RatingBar
            android:id="@+id/rbReviewStars"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:isIndicator="true"
            android:numStars="5"
            android:stepSize="1.0"
            android:theme="@style/RatingBarColor" />

        <TextView
            android:id="@+id/tvReviewComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="15sp"
            tools:text="Beautiful views, clean route, and the early morning light made it memorable." />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
