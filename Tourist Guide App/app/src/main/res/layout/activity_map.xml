<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_background">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Route Summary Card (Top) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/routeSummaryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnCancelRoute"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/m3_on_surface" />

                <TextView
                    android:id="@+id/tvRouteTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Directions"
                    android:textAppearance="@style/TextAppearance.App.TitleMedium" />

                <TextView
                    android:id="@+id/tvRouteTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.TitleLarge"
                    android:textColor="@color/m3_primary"
                    tools:text="15 min" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/m3_outline_variant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRouteDistance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    tools:text="4.2 km" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartNavigation"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start"
                    app:icon="@android:drawable/ic_menu_directions" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Top Search & Filters Container -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="44dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="20dp"
            app:cardBackgroundColor="#00FFFFFF"
            app:cardCornerRadius="30dp"
            app:cardElevation="14dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_map_search_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/searchBtn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_map_icon_button"
                    android:padding="8dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/m3_primary" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/map_search_hint"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp"
                    android:textAppearance="@style/TextAppearance.App.BodyMedium"
                    android:textColor="@color/m3_on_surface"
                    android:textColorHint="@color/m3_outline" />

                <ImageView
                    android:id="@+id/clearSearchBtn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_map_icon_button"
                    android:contentDescription="@string/clear"
                    android:padding="8dp"
                    android:src="@drawable/ic_map_close"
                    android:visibility="gone"
                    app:tint="@color/m3_on_surface_variant" />

                <ImageView
                    android:id="@+id/micBtn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_map_icon_button"
                    android:padding="8dp"
                    android:src="@drawable/ic_map_mic"
                    app:tint="@color/m3_primary" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="@color/m3_outline_variant"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoryChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:stateListAnimator="@animator/chip_press"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="10dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:id="@+id/chipAllContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_chip_selected"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/chipAllIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_chip_all"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/chipAllLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/all"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/white"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipHistorical"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:stateListAnimator="@animator/chip_press"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/m3_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/chipHistoricalContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_chip_unselected"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/chipHistoricalIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_chip_historical"
                            app:tint="@color/marker_historical" />

                        <TextView
                            android:id="@+id/chipHistoricalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/cat_historical"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/m3_on_surface"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipNature"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:stateListAnimator="@animator/chip_press"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/m3_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/chipNatureContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_chip_unselected"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/chipNatureIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_chip_nature"
                            app:tint="@color/marker_nature" />

                        <TextView
                            android:id="@+id/chipNatureLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/cat_nature"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/m3_on_surface"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipReligious"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:stateListAnimator="@animator/chip_press"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/m3_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/chipReligiousContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_chip_unselected"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/chipReligiousIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_chip_religious"
                            app:tint="@color/marker_religious" />

                        <TextView
                            android:id="@+id/chipReligiousLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/cat_religious"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/m3_on_surface"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipFood"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:stateListAnimator="@animator/chip_press"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/m3_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/chipFoodContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_chip_unselected"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/chipFoodIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_chip_food"
                            app:tint="@color/marker_food" />

                        <TextView
                            android:id="@+id/chipFoodLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/cat_food"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/m3_on_surface"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipCulture"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:stateListAnimator="@animator/chip_press"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/m3_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/chipCultureContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_chip_unselected"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/chipCultureIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_chip_culture"
                            app:tint="@color/marker_culture" />

                        <TextView
                            android:id="@+id/chipCultureLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/cat_culture"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/m3_on_surface"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipAdventure"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:stateListAnimator="@animator/chip_press"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/m3_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/chipAdventureContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_chip_unselected"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/chipAdventureIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_chip_adventure"
                            app:tint="@color/marker_adventure" />

                        <TextView
                            android:id="@+id/chipAdventureLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/cat_adventure"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/m3_on_surface"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipScenic"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:stateListAnimator="@animator/chip_press"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/m3_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/chipScenicContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_chip_unselected"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/chipScenicIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_chip_scenic"
                            app:tint="@color/marker_scenic" />

                        <TextView
                            android:id="@+id/chipScenicLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/cat_scenic"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/m3_on_surface"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipShopping"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:stateListAnimator="@animator/chip_press"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/m3_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/chipShoppingContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_chip_unselected"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/chipShoppingIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_chip_shopping"
                            app:tint="@color/marker_shopping" />

                        <TextView
                            android:id="@+id/chipShoppingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/cat_shopping"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/m3_on_surface"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipEducational"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:stateListAnimator="@animator/chip_press"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/m3_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/chipEducationalContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_chip_unselected"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/chipEducationalIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_chip_educational"
                            app:tint="@color/marker_educational" />

                        <TextView
                            android:id="@+id/chipEducationalLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/cat_educational"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/m3_on_surface"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chipPark"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:stateListAnimator="@animator/chip_press"
                    app:cardBackgroundColor="#00FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/m3_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/chipParkContent"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_chip_unselected"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/chipParkIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_chip_park"
                            app:tint="@color/marker_park" />

                        <TextView
                            android:id="@+id/chipParkLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/cat_park"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/m3_on_surface"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <include layout="@layout/view_offline_cache_banner" />
    </LinearLayout>

    <!-- Hidden Go Button (Logic compatibility) -->
    <Button android:id="@+id/btnDirections" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="112dp"
        android:contentDescription="@string/map_my_location"
        app:backgroundTint="#F8FFFFFF"
        app:elevation="12dp"
        app:fabSize="normal"
        app:rippleColor="@color/m3_primary_container"
        app:srcCompat="@drawable/ic_map_my_location"
        app:tint="@color/m3_primary" />

    <!-- Bottom Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="32dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="@color/white"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_map_sheet_handle"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="20dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPlaceImage"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/RoundedImage"
                    tools:src="@android:drawable/ic_menu_gallery" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/placeName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.App.TitleLarge"
                        android:textColor="@color/m3_on_surface"
                        tools:text="Shaniwar Wada"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPlaceCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.LabelLarge"
                            tools:text="Historical" />

                        <View
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:layout_marginHorizontal="8dp"
                            android:background="@drawable/dot_separator" />

                        <TextView
                            android:id="@+id/tvPlaceRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.BodySmall"
                            android:textStyle="bold"
                            tools:text="4.8 ⭐" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPlaceDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.App.BodySmall"
                        tools:text="1.2 km away" />

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/placeDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                android:textColor="@color/m3_on_surface_variant"
                tools:text="A historical fortification in the city of Pune in Maharashtra, India..."/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="24dp"
                android:paddingBottom="32dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewDetails"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/map_view_details" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSheetGo"
                    style="@style/AppButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1.2"
                    android:layout_marginStart="8dp"
                    android:text="@string/map_get_directions"
                    app:icon="@drawable/ic_map_directions" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Empty State for Search/Filters -->
    <LinearLayout
        android:id="@+id/emptyStateExplore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/explore_empty_title"
            android:textAppearance="@style/TextAppearance.App.TitleMedium"
            android:textColor="@color/color_on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/explore_empty_msg"
            android:textAppearance="@style/TextAppearance.App.BodySmall"
            android:textColor="@color/color_text_muted" />
    </LinearLayout>

    <!-- Floating Navigation Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:layout_gravity="bottom"
        app:cardCornerRadius="36dp"
        app:cardElevation="18dp"
        app:cardBackgroundColor="#F8FFFFFF"
        app:strokeWidth="1dp"
        app:strokeColor="@color/m3_outline_variant">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            style="@style/AppBottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:elevation="0dp"
            app:itemIconSize="26dp"
            app:labelVisibilityMode="selected"
            app:menu="@menu/bottom_nav_menu" />
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
