<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/card_lift"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:rippleColor="@color/color_primary_container">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="100dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Icon Container with Gradient -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_quick_action_premium">

            <ImageView
                android:id="@+id/ivQuickAccessIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="@color/white" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvQuickAccessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/color_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Count Badge -->
        <TextView
            android:id="@+id/tvQuickAccessCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_count_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
