<?xml version="1.0" encoding="utf-8"?>
<!-- Strong bottom-heavy dark gradient for hero image overlay.
     Transparent at top → deep dark at bottom for text legibility. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="#00000000"
        android:centerColor="#80000000"
        android:endColor="#D9000000"
        android:type="linear" />
</shape>
