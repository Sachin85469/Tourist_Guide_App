<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:name=".TouristGuideApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.TouristGuideApp">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_API_KEY" />

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TouristGuideApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />

        <activity
            android:name=".SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />

        <activity
            android:name=".InterestSelectionActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".PlaceDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".FavoritesActivity"
            android:exported="false" />
        <activity
            android:name=".MapActivity"
            android:exported="false" />
        <activity
            android:name=".RouteActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".PlanTripActivity"
            android:exported="false" />
        <activity
            android:name=".ItineraryActivity"
            android:exported="false" />
        <activity
            android:name=".CategoryPlacesActivity"
            android:exported="false" />
        <activity
            android:name=".MoodActivity"
            android:exported="false" />
        <activity
            android:name=".QuickPlanActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".MyReviewsActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".NotificationHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".TripHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".TripDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".NotificationSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".PlaceEditorActivity"
            android:exported="false" />
        <activity
            android:name=".communication.CommunicationHubActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".PhrasebookActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".ReplyTranslatorActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".NearbyPlacesActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".AiChatActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AccountInfoActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".DeviceManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".PrivacySettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".LoginHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".SecurityActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".LanguageActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".sos.ui.SOSSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />
        <activity
            android:name=".sos.ui.SOSHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.TouristGuideApp" />

        <service
            android:name=".sos.service.SOSForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".sos.service.FloatingSOSService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <service
            android:name=".sos.service.SOSAccessibilityService"
            android:label="SOS Trigger Service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACCESSIBILITY_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sos_accessibility_config" />
        </service>
    </application>

</manifest>
