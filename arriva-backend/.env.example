# Arriva Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# \u2500\u2500\u2500 Required \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
# Your Anthropic API key (kept server-side ONLY, never sent to the device)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Shared secret the Android app sends in the X-App-Token header.
# Generate a strong random string, e.g.: openssl rand -hex 32
APP_TOKEN=your-secret-token-here

# ────────────────────────────────────────────────────────────────────────────
PORT=3000
ANTHROPIC_MODEL=claude-sonnet-4-6
REQUEST_BODY_LIMIT=64kb
MONGODB_URI=mongodb+srv://sachin:Sachin12345Pass@cluster0.sn7fiyr.mongodb.net/?appName=Cluster0
