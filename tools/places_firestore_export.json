{
  "exportVersion": 2,
  "collection": "places",
  "schema": {
    "description": "Wrapper for batch import scripts. Each item becomes places/{id} with fields written as Firestore fields.",
    "documentIdField": "id",
    "idStrategy": "Use id as Firestore document path. Must match fields.legacyId and match old Place.getId() so PlaceMapper (documentId -> Place.id) does not break favorites.",
    "slugField": "fields.slug — stable human-readable key (unique). Optional in Firestore; ignored by PlaceDto until you add it to the contract.",
    "placeDtoContract": "Names align with com.arriva.touristguideapp.data.places.PlacesFirestoreContract",
    "queries": "FirestorePlaceDataSource filters on status=published; optional isTopPick, category. Composite indexes required for multi-filter queries.",
    "ratings": "DataProvider never calls setRating; runtime default is 4.0 — ratingAvg set to 4.0 for all rows."
  },
  "notes": [
    "Import with Firebase Admin SDK (batch writes); set fields.location to GeoPoint(lat, lng) in script if desired (optional; lat/lng alone satisfy PlaceDto).",
    "drawableAssetKey / galleryDrawableKeys are migration metadata only (not read by PlaceDto today).",
    "Omit imageUrl / galleryImageUrls until Storage URLs exist, or add URLs later with merge writes.",
    "Prevent duplicates: deterministic id + merge:true on re-import."
  ],
