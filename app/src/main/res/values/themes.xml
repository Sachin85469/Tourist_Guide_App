<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TouristGuideApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Main branding colors. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!-- View backgrounds -->
        <item name="android:windowBackground">@color/bg_light</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.TouristGuideApp" parent="Base.Theme.TouristGuideApp" />

    <!-- Custom View Styles -->
    <style name="PremiumCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="FloatingSearchBar" parent="PremiumCard">
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedImage" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="RoundedButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
</resources>