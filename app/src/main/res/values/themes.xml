<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TouristGuideApp" parent="Theme.Material3.Light.NoActionBar">
        <!-- Main branding colors. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!-- View backgrounds -->
        <item name="android:windowBackground">@color/bg_light</item>
    </style>

    <style name="Theme.TouristGuideApp" parent="Base.Theme.TouristGuideApp" />

    <style name="CircleImage" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>
