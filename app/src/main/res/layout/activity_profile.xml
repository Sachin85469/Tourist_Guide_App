<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_premium_surface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Hero Header Section -->
            <View
                android:id="@+id/heroBackground"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="@drawable/bg_hero_gradient"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/heroCurve"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_hero_curved"
                android:backgroundTint="@color/premium_bg_start"
                android:rotation="180"
                app:layout_constraintBottom_toBottomOf="@id/heroBackground" />

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_directions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <!-- Profile Avatar Section -->
            <RelativeLayout
                android:id="@+id/avatarContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@id/heroBackground"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/heroBackground">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProfileImage"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:cardCornerRadius="75dp"
                    app:cardElevation="16dp"
                    app:strokeColor="@color/adaptive_surface"
                    app:strokeWidth="5dp">

                    <ImageView
                        android:id="@+id/ivProfileImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnEditImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignEnd="@id/cardProfileImage"
                    android:layout_alignBottom="@id/cardProfileImage"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    app:backgroundTint="@color/accent"
                    app:elevation="20dp"
                    app:fabCustomSize="44dp"
                    app:srcCompat="@android:drawable/ic_menu_camera"
                    app:tint="@color/primary_dark" />
            </RelativeLayout>

            <!-- User Basic Info -->
            <LinearLayout
                android:id="@+id/userInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/avatarContainer">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Premium User"
                    android:textColor="@color/adaptive_text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="user@exploreease.com"
                    android:textColor="@color/adaptive_text_primary"
                    android:textSize="16sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLoginProvider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Verified Account"
                    app:chipBackgroundColor="@color/adaptive_glass_surface"
                    app:chipStrokeWidth="0dp"
                    app:chipIcon="@android:drawable/ic_menu_info_details"
                    app:chipIconTint="@color/primary"
                    android:textColor="@color/adaptive_text_primary" />
            </LinearLayout>

            <!-- Stats Row -->
            <LinearLayout
                android:id="@+id/statsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                app:layout_constraintTop_toBottomOf="@id/userInfo">

                <include layout="@layout/item_stat_card" android:id="@+id/statTrips" />
                <include layout="@layout/item_stat_card" android:id="@+id/statFavs" />
                <include layout="@layout/item_stat_card" android:id="@+id/statReviews" />
            </LinearLayout>

            <!-- Action Cards -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="24dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/adaptive_surface"
                app:layout_constraintTop_toBottomOf="@id/statsRow">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditProfile"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="start|center_vertical"
                        android:text="Edit Profile Details"
                        android:textAllCaps="false"
                        android:textColor="@color/adaptive_text_primary"
                        android:textSize="16sp"
                        app:icon="@android:drawable/ic_menu_edit"
                        app:iconPadding="16dp"
                        app:iconSize="24dp"
                        app:iconTint="@color/primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/adaptive_divider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSettings"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="start|center_vertical"
                        android:text="Security &amp; Privacy"
                        android:textAllCaps="false"
                        android:textColor="@color/adaptive_text_primary"
                        android:textSize="16sp"
                        app:icon="@android:drawable/ic_menu_manage"
                        app:iconPadding="16dp"
                        app:iconSize="24dp"
                        app:iconTint="@color/primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/adaptive_divider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotificationHistory"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="start|center_vertical"
                        android:text="Notification History"
                        android:textAllCaps="false"
                        android:textColor="@color/adaptive_text_primary"
                        android:textSize="16sp"
                        app:icon="@android:drawable/ic_dialog_info"
                        app:iconPadding="16dp"
                        app:iconSize="24dp"
                        app:iconTint="@color/primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/adaptive_divider" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotificationSettings"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="start|center_vertical"
                        android:text="Notification Settings"
                        android:textAllCaps="false"
                        android:textColor="@color/adaptive_text_primary"
                        android:textSize="16sp"
                        app:icon="@android:drawable/ic_dialog_info"
                        app:iconPadding="16dp"
                        app:iconSize="24dp"
                        app:iconTint="@color/primary" />

                    <View
                        android:id="@+id/dividerAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/adaptive_divider"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdminDashboard"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="start|center_vertical"
                        android:text="Admin Dashboard"
                        android:textAllCaps="false"
                        android:textColor="@color/accent"
                        android:textSize="16sp"
                        android:visibility="gone"
                        app:icon="@android:drawable/ic_menu_manage"
                        app:iconPadding="16dp"
                        app:iconSize="24dp"
                        app:iconTint="@color/accent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Edit Name Overlay (Initially Hidden) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEditName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="24dp"
                android:visibility="gone"
                app:cardCornerRadius="28dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/adaptive_surface"
                app:layout_constraintTop_toBottomOf="@id/cardActions">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Update Name"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:startIconDrawable="@android:drawable/ic_menu_edit">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEditName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveName"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/primary"
                        android:text="Apply Changes"
                        android:textAllCaps="false"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="24dp"
                android:backgroundTint="@color/adaptive_logout_bg"
                android:text="Sign Out"
                android:textAllCaps="false"
                android:textColor="@color/adaptive_logout_text"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:iconTint="@color/adaptive_logout_text"
                app:layout_constraintTop_toBottomOf="@id/cardEditName"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="40dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>