<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/adaptive_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPhraseCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Emergency" />

            <ImageButton
                android:id="@+id/btnPhraseCopy"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/phrasebook_copy"
                android:src="@android:drawable/ic_menu_save"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnPhraseFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/phrasebook_favorite"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/primary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/communication_original_phrase"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPhraseOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/adaptive_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Call the police." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/adaptive_divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/communication_translated_phrase"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="40dp">

            <ProgressBar
                android:id="@+id/progressPhraseTranslation"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPhraseTranslated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/adaptive_text_primary"
                android:textSize="16sp"
                tools:text="पोलीसांना बोलावा." />

            <TextView
                android:id="@+id/tvPhraseTranslationError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/indicator_red"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhraseSpeak"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/communication_speak"
            android:textAllCaps="false"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_volume"
            app:iconGravity="textStart"
            app:iconTint="@color/primary"
            app:strokeColor="@color/adaptive_card_stroke" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
