<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:osmdroid="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="30dp"
            android:paddingHorizontal="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/premium_search_bg"
            android:elevation="12dp">

            <!-- Search Icon (Acting as searchBtn for logic) -->
            <ImageButton
                android:id="@+id/searchBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#7B1FA2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="8dp"/>

            <!-- Input -->
            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Search places..."
                android:textColor="#111111"
                android:textColorHint="#888888"
                android:textSize="16sp"
                android:background="@android:color/transparent"
                android:textCursorDrawable="@null"
                android:padding="4dp"/>

            <!-- Mic Button -->
            <ImageView
                android:id="@+id/micBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/mic_strong_bg"
                android:padding="10dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:clickable="true"
                android:focusable="true"
                app:tint="#FFFFFF"/>

            <!-- Hidden Go Button (Kept for logic compatibility) -->
            <Button
                android:id="@+id/btnDirections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAtm"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="ATM"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/chip_clean_bg"
                    android:elevation="6dp"
                    android:shadowColor="#55000000"
                    android:shadowRadius="2"
                    android:foreground="?attr/selectableItemBackground"/>

                <Button
                    android:id="@+id/btnCafe"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Cafe"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/chip_clean_bg"
                    android:elevation="6dp"
                    android:shadowColor="#55000000"
                    android:shadowRadius="2"
                    android:foreground="?attr/selectableItemBackground"/>

                <Button
                    android:id="@+id/btnRestaurant"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Food"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/chip_clean_bg"
                    android:elevation="6dp"
                    android:shadowColor="#55000000"
                    android:shadowRadius="2"
                    android:foreground="?attr/selectableItemBackground"/>

                <Button
                    android:id="@+id/btnBank"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Bank"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/chip_clean_bg"
                    android:elevation="6dp"
                    android:shadowColor="#55000000"
                    android:shadowRadius="2"
                    android:foreground="?attr/selectableItemBackground"/>

                <Button
                    android:id="@+id/btnFuel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Fuel"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/chip_clean_bg"
                    android:elevation="6dp"
                    android:shadowColor="#55000000"
                    android:shadowRadius="2"
                    android:foreground="?attr/selectableItemBackground"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Bottom Sheet -->
    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bottom_sheet_bg"
        android:padding="20dp"
        android:elevation="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#CCCCCC"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/placeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:text="Place Name"/>

        <TextView
            android:id="@+id/placeDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textColor="#666666"
            android:text="Details about the place appear here."/>

        <Button
            android:id="@+id/btnSheetGo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="Get Directions"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_gradient"
            android:foreground="?attr/selectableItemBackground"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>