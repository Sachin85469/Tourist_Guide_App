<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHomeUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ExploreEase"
                        android:textColor="@color/color_on_surface"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHomeUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tourist Guide"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileIcon"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="2dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeColor="@color/color_outline_variant"
                    app:strokeWidth="1.5dp" />
            </RelativeLayout>

            <!-- Search Bar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="27dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/color_surface"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/color_outline" />

                    <EditText
                        android:id="@+id/editTextSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Search places..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:textSize="15sp"
                        android:textColorHint="@color/color_outline" />

                    <ImageView
                        android:id="@+id/btnVoiceSearch"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@android:drawable/ic_menu_directions"
                        app:tint="@color/color_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section: Categories -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Categories"
                android:textAppearance="@style/TextAppearance.App.SectionTitle"
                android:textColor="@color/color_on_surface" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Category: All -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/chip_press"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/color_primary"
                        app:rippleColor="@color/color_primary_dark"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/txtAllCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌍  All"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Category: History -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnHistorical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/chip_press"
                        app:cardBackgroundColor="@color/color_surface_variant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:rippleColor="@color/color_primary_container"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/txtHistoryCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏛️  History"
                                android:textColor="@color/color_primary_dark"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Category: Spiritual -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/spiritualCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/chip_press"
                        app:cardBackgroundColor="@color/color_surface_variant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:rippleColor="@color/color_primary_container"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/txtSpiritualCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🙏  Spiritual"
                                android:textColor="@color/color_primary_dark"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Category: Food -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnFood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/chip_press"
                        app:cardBackgroundColor="@color/color_surface_variant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:rippleColor="@color/color_primary_container"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/txtFoodCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🍕  Food"
                                android:textColor="@color/color_primary_dark"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Category: Shopping -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/shoppingCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/chip_press"
                        app:cardBackgroundColor="@color/color_surface_variant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:rippleColor="@color/color_primary_container"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/txtShoppingCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🛍️  Shopping"
                                android:textColor="@color/color_primary_dark"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Category: Nature -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnNature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/chip_press"
                        app:cardBackgroundColor="@color/color_surface_variant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:rippleColor="@color/color_primary_container"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/txtNatureCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌲  Nature"
                                android:textColor="@color/color_primary_dark"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Category: Adventure -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnAdventure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/chip_press"
                        app:cardBackgroundColor="@color/color_surface_variant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:rippleColor="@color/color_primary_container"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/txtAdventureCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎢  Adventure"
                                android:textColor="@color/color_primary_dark"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Category: Entertainment -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/entertainmentCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@animator/chip_press"
                        app:cardBackgroundColor="@color/color_surface_variant"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:rippleColor="@color/color_primary_container"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/txtEntertainmentCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎮  Entertainment"
                                android:textColor="@color/color_primary_dark"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <include layout="@layout/view_offline_cache_banner" />

            <!-- Section: Recommended -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:text="Recommended for You"
                android:textAppearance="@style/TextAppearance.App.SectionTitle"
                android:textColor="@color/color_on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:text="Hand-picked premium destinations"
                android:textAppearance="@style/TextAppearance.App.CardDescription"
                android:textColor="@color/color_text_secondary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewPlaces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="100dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Nearby Now FAB — purple, above the AI chat FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNearbyNow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:layout_marginBottom="152dp"
        android:contentDescription="Nearby Now"
        app:srcCompat="@android:drawable/ic_menu_mylocation"
        app:tint="@color/white"
        app:backgroundTint="#7C3AED"
        app:elevation="8dp"
        app:rippleColor="#6D28D9"
        app:fabSize="normal" />

    <!-- AI Assistant Quick Launch -->
    <FrameLayout
        android:id="@+id/fabAiChat"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:layout_marginBottom="80dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ai_assistant_glow"
            android:translationZ="2dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAiAssistant"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:clickable="false"
            android:focusable="false"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:strokeColor="@color/color_primary"
            app:strokeWidth="1dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAiAssistantIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arriva_ai"
                app:shapeAppearanceOverlay="@style/CircleImage" />

        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
