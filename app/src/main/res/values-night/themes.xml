<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TouristGuideApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Main branding colors. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/adaptive_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- View backgrounds -->
        <item name="android:windowBackground">@color/adaptive_bg</item>
    </style>
</resources>